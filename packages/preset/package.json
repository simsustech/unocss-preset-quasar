{
  "name": "unocss-preset-quasar",
  "version": "0.5.6",
  "description": "UnoCSS preset for Quasar Framework",
  "keywords": [
    "material-design",
    "md3",
    "preset",
    "quasar",
    "unocss"
  ],
  "homepage": "https://github.com/simsustech/unocss-preset-quasar/tree/main/#readme",
  "bugs": {
    "url": "https://github.com/simsustech/unocss-preset-quasar/issues"
  },
  "license": "MIT",
  "author": "Stefan van Herwijnen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simsustech/unocss-preset-quasar.git",
    "directory": "packages/preset"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.js"
  ],
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": {
      "source": "./src/styles/index.ts",
      "types": "./dist/types/styles/index.d.ts",
      "import": "./dist/styles/index.js",
      "require": "./dist/styles/index.js",
      "default": "./dist/styles/index.js"
    },
    "./theme": {
      "source": "./src/theme/index.ts",
      "types": "./dist/types/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "require": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./runtime": {
      "source": "./src/runtime.ts",
      "types": "./dist/types/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "test": "vitest test/"
  },
  "dependencies": {
    "@poupe/material-color-utilities": "^0.4.1",
    "@unocss/preset-icons": "^66.10.1",
    "@unocss/preset-mini": "^66.10.1",
    "@unocss/preset-web-fonts": "^66.10.1",
    "@unocss/transformer-directives": "^66.10.1",
    "@unocss/transformer-variant-group": "^66.10.1",
    "animated-unocss": "^0.0.6"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@quasar/extras": "^2.0.4",
    "@quasar/quasar-ui-qcalendar": "^5.3.0",
    "@quasar/quasar-ui-qmarkdown": "^4.2.1",
    "@quasar/quasar-ui-qmediaplayer": "^3.0.1",
    "@types/node": "^26.5.0",
    "@unocss/core": "^66.10.1",
    "@unocss/preset-icons": "^66.10.1",
    "@unocss/preset-mini": "^66.10.1",
    "@unocss/preset-uno": "^66.10.1",
    "@unocss/preset-web-fonts": "^66.10.1",
    "@unocss/preset-wind": "^66.10.1",
    "@unocss/preset-wind4": "^66.10.1",
    "@unocss/transformer-directives": "^66.10.1",
    "@unocss/transformer-variant-group": "^66.10.1",
    "quasar": "^2.31.0",
    "sass": "^1.104.1",
    "typescript": "^7.0.2",
    "unocss": "^66.10.1",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@unocss/core": "^66.10.1",
    "quasar": "^2.31.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
