{
  "name": "unocss-preset-quasar",
  "version": "0.3.8",
  "description": "UnoCSS preset for Quasar Framework",
  "keywords": [
    "material-design",
    "md3",
    "preset",
    "quasar",
    "unocss"
  ],
  "homepage": "https://github.com/simsustech/unocss-preset-quasar/tree/main/#readme",
  "bugs": {
    "url": "https://github.com/simsustech/unocss-preset-quasar/issues"
  },
  "license": "MIT",
  "author": "Stefan van Herwijnen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simsustech/unocss-preset-quasar.git",
    "directory": "packages/preset"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.js"
  ],
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "source": "./src/styles/index.ts",
      "types": "./dist/types/styles/index.d.ts",
      "import": "./dist/styles/index.js"
    },
    "./theme": {
      "source": "./src/theme.ts",
      "types": "./dist/types/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./vite-aliases": {
      "source": "./src/vite-aliases.ts",
      "types": "./dist/types/vite-aliases.d.ts",
      "import": "./dist/vite-aliases.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "test": "vitest test/"
  },
  "dependencies": {
    "@poupe/material-color-utilities": "^0.4.1",
    "@unocss/core": "^66.7.4",
    "@unocss/preset-uno": "^66.7.4",
    "@unocss/preset-web-fonts": "66.7.4",
    "@unocss/preset-wind": "^66.7.4",
    "@unocss/preset-wind4": "66.7.4",
    "animated-unocss": "^0.0.6",
    "unocss": "66.7.4"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@quasar/extras": "^2.0.1",
    "@quasar/quasar-ui-qmarkdown": "^2.0.5",
    "@quasar/quasar-ui-qmediaplayer": "^3.0.0-rc.1",
    "@types/node": "^26.1.0",
    "@unocss/preset-icons": "^66.7.4",
    "@unocss/preset-mini": "66.7.4",
    "quasar": "^2.20.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "quasar": "^2.20.2"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
