    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "25.9.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/reactivity": "3.5.35",
