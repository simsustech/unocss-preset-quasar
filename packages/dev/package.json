    "fastify": "5.8.5",
    "npm-run-all": "4.1.5",
    "typescript": "6.0.3",
    "unocss": "66.7.0",
    "unocss-preset-quasar": "workspace:*",
    "vite": "8.0.14",
    "vitrify": "0.26.6",
    "workbox-window": "7.4.1"
  },
  "productName": "App"
