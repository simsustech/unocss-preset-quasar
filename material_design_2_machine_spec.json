{
  "system_metadata": {
    "specification_name": "Material Design 2 (M2) Complete Machine Specification Engine Data",
    "specification_version": "2.0 (Legacy Baseline)",
    "ecosystem_targets": [
      "Vue.js / Vuetify",
      "Angular Material",
      "Web Components"
    ],
    "encoding_format": "JSON-Schema-Compliant AST",
    "validation_engine_compatibility": "Automated Visual QA, Playwright Linter, Visual Regression Runners"
  },
  "accessibility_and_contrast_system": {
    "contrast_verification_algorithms": {
      "wcag_2_0_and_2_1": {
        "aa_compliance_minimum": {
          "normal_text_under_18pt_px_24": "4.5:1",
          "large_text_over_18pt_or_14pt_bold": "3.0:1",
          "ui_components_and_graphics": "3.0:1"
        },
        "aaa_compliance_maximum": {
          "normal_text_under_18pt_px_24": "7.0:1",
          "large_text_over_18pt_or_14pt_bold": "4.5:1"
        }
      }
    },
    "interactive_targets": {
      "physical_boundary_minimum_px": {
        "width": 48,
        "height": 48
      },
      "inline_touch_targets": {
        "description": "Elements must be separated by at least 8px of space to prevent overlap, making cumulative grid lines snap to 8dp boundaries."
      },
      "focus_ring_and_states": {
        "description": "M2 focuses primarily on standard colored background overlays rather than dynamic physical clearing focus rings."
      }
    }
  },
  "grid_and_layout_engine": {
    "baseline_grid": {
      "mobile_tablet_desktop_dp_grid": 8,
      "typography_alignment_dp_grid": 4
    },
    "viewport_breakpoint_array": {
      "xs_small_handset": {
        "width_range": "0px <= w < 600px",
        "columns": 4,
        "margins_px": 16,
        "gutter_space_px": 16
      },
      "sm_medium_handset_tablet": {
        "width_range": "600px <= w < 960px",
        "columns": 8,
        "margins_px": 24,
        "gutter_space_px": 24
      },
      "md_large_tablet_desktop": {
        "width_range": "960px <= w < 1280px",
        "columns": 12,
        "margins_px": 24,
        "gutter_space_px": 24
      },
      "lg_large_desktop": {
        "width_range": "1280px <= w < 1920px",
        "columns": 12,
        "margins_px": 24,
        "gutter_space_px": 24
      },
      "xl_ultra_large_desktop": {
        "width_range": "w >= 1920px",
        "columns": 12,
        "margins_px": 24,
        "gutter_space_px": 24
      }
    }
  },
  "design_token_pipeline": {
    "color_system_mechanics": {
      "architecture": "Color Palette Hues (50-900) + Accent Scales (A100-A700)",
      "elevation_strategy": "Semi-transparent white overlay sheets stacked over the base surface color to visually represent height in dark mode."
    },
    "core_semantic_palette_mapping": {
      "primary": "Main brand expression color used across headers and key actions.",
      "primary_variant": "Darker or lighter alternative of the primary brand color.",
      "secondary": "Accent color for floating action components, selections, and highlights.",
      "secondary_variant": "Alternative variant of the secondary accent color.",
      "background": "The underlying base color behind scrollable application content.",
      "surface": "The structural sheet color applied to cards, sheets, menus, and dialogs.",
      "error": "The functional color reserved exclusively for validation failures.",
      "on_primary": "High contrast color safe for text/icons placed over the primary color.",
      "on_secondary": "High contrast color safe for text/icons placed over the secondary color.",
      "on_background": "High contrast color safe for text/icons placed over the background color.",
      "on_surface": "High contrast color safe for text/icons placed over the surface color.",
      "on_error": "High contrast color safe for text/icons placed over the error color."
    }
  },
